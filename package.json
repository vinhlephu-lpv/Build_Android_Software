{
  "name": "build-android-software",
  "version": "1.0.0",
  "description": "Desktop tool to build, run and interact with React Native CLI apps on an Android device simulator",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "app": "electron .",
    "electron": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.aurasoft.buildandroidsoftware",
    "productName": "Build Android Software",
    "compression": "store",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "unpackDirName": "BuildAndroidSoftware_App",
      "requestExecutionLevel": "user"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "src/**/*",
      "server.js",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/esbuild/**/*"
    ]
  },
  "keywords": [
    "react-native",
    "android",
    "simulator",
    "builder"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-flow-strip-types": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "cors": "^2.8.5",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "flow-remove-types": "^2.328.0",
    "open": "^10.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native-web": "^0.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^25.1.8"
  }
}
